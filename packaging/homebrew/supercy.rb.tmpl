# This file is written by Supercy's release workflow (scripts/release/homebrew-cask.sh). DO NOT EDIT.
cask "supercy" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/weikxs/supercy/releases/download/v#{version}/supercy_#{version}_darwin_universal.dmg"
  name "Supercy"
  desc "Lightweight menu bar clipboard manager"
  homepage "https://github.com/weikxs/supercy"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :sonoma"

  app "Supercy.app"

  # The app is not signed by Apple: without this, macOS refuses to open it the first time.
  postflight do
    system_command "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "#{appdir}/Supercy.app"]
  end

  # No zap stanza: the clipboard history, its key in the login keychain and the settings are never
  # removed by Homebrew.
end
